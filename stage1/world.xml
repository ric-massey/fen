<mujoco model="fen_stage1_arm">
  <!-- Stage 1 body: 4 actuated DOF, fixed base.
       Deliberately learnable-but-not-trivial: coupled multi-link dynamics
       under gravity, with joint limits and damping. -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.6" armature="0.02"/>
    <geom type="capsule" size="0.035" rgba="0.72 0.72 0.78 1" density="900"/>
    <motor ctrlrange="-2.5 2.5" gear="1"/>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.8" rgba="0.28 0.28 0.33 1"/>

    <body name="base" pos="0 0 0">
      <geom fromto="0 0 -0.12 0 0 0" size="0.05" rgba="0.4 0.4 0.45 1"/>

      <body name="l1" pos="0 0 0">
        <joint name="j1" type="hinge" axis="0 0 1" range="-3.0 3.0"/>
        <geom fromto="0 0 0 0.20 0 0"/>

        <body name="l2" pos="0.20 0 0">
          <joint name="j2" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
          <geom fromto="0 0 0 0.20 0 0"/>

          <body name="l3" pos="0.20 0 0">
            <joint name="j3" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
            <geom fromto="0 0 0 0.18 0 0"/>

            <body name="l4" pos="0.18 0 0">
              <joint name="j4" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
              <geom fromto="0 0 0 0.15 0 0" rgba="0.85 0.6 0.4 1"/>
              <site name="tip" pos="0.15 0 0" size="0.02"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m1" joint="j1"/>
    <motor name="m2" joint="j2"/>
    <motor name="m3" joint="j3"/>
    <motor name="m4" joint="j4"/>
  </actuator>
</mujoco>
